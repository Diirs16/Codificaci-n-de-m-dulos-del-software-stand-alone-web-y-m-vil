# ================================================================
# PETCONNECT - Plantilla de variables de entorno
# Copia este archivo como ".env" y completa tus propios valores.
# El archivo ".env" real NUNCA se sube a Git/GitHub (ver .gitignore).
# ================================================================

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3310
DB_NAME=petconnect
DB_USER=root
DB_PASSWORD=

# Conexiones del pool (item 4.5, NC-003). Vacio = 10. Entre 1 y 32 (limite de
# mysql-connector). Cada peticion toma una, la usa y la devuelve.
DB_POOL_SIZE=

# Modo debug de Flask (NC-007). Vacio o 0 = apagado (lo normal).
# Ponlo en 1 solo en tu computador y por un rato: el depurador de Werkzeug
# permite ejecutar codigo en el servidor. Nunca en un servidor publico.
FLASK_DEBUG=

# Entorno de la app (A-10). Vacio = NO es desarrollo (lo normal y lo seguro).
# Solo con APP_ENV=desarrollo, si el correo falla, el codigo OTP se muestra en
# la consola del servidor (solo el codigo, nunca el correo) para probar sin
# correo real. Usalo solo en tu computador. Cualquier otro valor (ej. produccion)
# = no se muestra nada. Es independiente de FLASK_DEBUG.
APP_ENV=

# Donde escucha "python api.py" (item 5.2, A-30). Vacio = 127.0.0.1: solo tu
# computador la ve (lo normal). 0.0.0.0 = la ven otros equipos de tu red; en
# Docker no hace falta (Gunicorn ya escucha en 0.0.0.0, ver gunicorn.conf.py).
# Nunca 0.0.0.0 junto con FLASK_DEBUG=1.
API_HOST=

# Proxy de confianza delante de la API (item 5.2). Vacio = no hay proxy: el
# limite de peticiones cuenta por la IP que se conecta. 1 = la API esta detras
# de nginx (docker-compose): cuenta por la IP que nginx anota en
# X-Forwarded-For. x-real-ip = la API esta en Railway (item 5.5): cuenta por la
# IP del encabezado X-Real-IP, que escribe el borde de Railway. Sin proxy, NO
# lo pongas en 1 ni en x-real-ip: cualquiera podria inventarse ese encabezado y
# saltarse el limite.
PROXY_CONFIABLE=

# Paginas que pueden llamar a la API desde el navegador (CORS, item 5.5).
# Vacio = las de desarrollo (localhost:5173, 8081, 19006 y 8090): lo normal en
# tu computador y en Docker. Con valores, separados por comas, REEMPLAZAN a las
# de desarrollo; cada uno https://dominio, sin ruta ni "*". Ejemplo (Railway):
#   CORS_ORIGENES=https://petconnect-git-main-tuusuario.vercel.app
CORS_ORIGENES=

# Envio de correo. Si falla o no esta configurado:
#  - con APP_ENV=desarrollo: el codigo se muestra en la consola y la API
#    responde "Codigo enviado" (para probar sin correo real);
#  - sin APP_ENV=desarrollo: la API responde 503 "No pudimos enviar el codigo
#    a tu correo..." y el codigo se descarta (no queda en ningun log).
#
# EMAIL_MODE=sdk   -> API de Mailtrap (requiere MAILTRAP_API_TOKEN + dominio verificado)
# EMAIL_MODE=smtp  -> Sandbox de Mailtrap (solo pruebas, no llega a bandejas reales)
# EMAIL_MODE=gmail -> SMTP real de Gmail (el correo SI llega a la bandeja del destinatario)
EMAIL_MODE=gmail

MAILTRAP_API_TOKEN=
MAILTRAP_SENDER=noreply@tudominio.com

# Gmail SMTP: GMAIL_APP_PASSWORD es una "contrasena de aplicacion" de 16
# caracteres, NO tu contrasena normal de Gmail. Se genera en
# https://myaccount.google.com/apppasswords (requiere verificacion en dos
# pasos activada en la cuenta).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Claves de seguridad: NO escribirlas a mano, se generan automaticamente
# ejecutando:  python generate_keys.py
# (item 6.3, A-16: no borra nada. Si el .env no existe lo crea desde esta
# plantilla; si existe, solo llena las claves vacias o que falten. Si ya tienen
# valor no las cambia: cambiar JWT_SECRET cierra todas las sesiones y cambiar
# FERNET_KEY deja ilegibles los codigos OTP pendientes.)
#
# JWT_SECRET es OBLIGATORIO y debe tener minimo 32 bytes: sin el, la API no arranca.
# Para generar solo esta clave:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
FERNET_KEY=
