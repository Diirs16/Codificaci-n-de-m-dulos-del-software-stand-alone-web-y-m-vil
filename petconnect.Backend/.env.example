# ================================================================
# PETCONNECT - Plantilla de variables de entorno
# Copia este archivo como ".env" y completa tus propios valores.
# El archivo ".env" real NUNCA se sube a Git/GitHub (ver .gitignore).
# ================================================================

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3310
DB_NAME=petconnect
DB_USER=root
DB_PASSWORD=

# Envio de correo (opcional). Si falla o no esta configurado, el codigo de
# verificacion de registro se imprime en la consola del servidor, asi que
# la app funciona igual sin necesidad de un correo real.
#
# EMAIL_MODE=sdk   -> API de Mailtrap (requiere MAILTRAP_API_TOKEN + dominio verificado)
# EMAIL_MODE=smtp  -> Sandbox de Mailtrap (solo pruebas, no llega a bandejas reales)
# EMAIL_MODE=gmail -> SMTP real de Gmail (el correo SI llega a la bandeja del destinatario)
EMAIL_MODE=gmail

MAILTRAP_API_TOKEN=
MAILTRAP_SENDER=noreply@tudominio.com

# Gmail SMTP: GMAIL_APP_PASSWORD es una "contrasena de aplicacion" de 16
# caracteres, NO tu contrasena normal de Gmail. Se genera en
# https://myaccount.google.com/apppasswords (requiere verificacion en dos
# pasos activada en la cuenta).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Claves de seguridad: NO escribirlas a mano, se generan automaticamente
# ejecutando una sola vez:  python generate_keys.py
# (generate_keys.py sobrescribe todo el .env: si ya tienes uno, genera solo la clave que falte)
#
# JWT_SECRET es OBLIGATORIO y debe tener minimo 32 bytes: sin el, la API no arranca.
# Para generar solo esta clave:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
FERNET_KEY=
