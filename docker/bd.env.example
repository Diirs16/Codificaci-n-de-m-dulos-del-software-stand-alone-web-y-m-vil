# ================================================================
# PETCONNECT — plantilla de la BD en Docker (item 5.2, A-30)
#
# Copia este archivo como docker/bd.env (en esta misma carpeta) y llenalo.
# docker/bd.env NO se sube a Git (regla *.env del .gitignore).
# El nombre de la base (petconnect) ya esta en docker-compose.yml.
#
# Inventa contrasenas nuevas y largas: NO reutilices la de tu MariaDB local
# ni ninguna otra. Solo se usan dentro de Docker.
# Estos valores se leen solo la PRIMERA vez (volumen vacio). Cambiarlos
# despues no cambia las cuentas ya creadas.
# ================================================================

# Contrasena del administrador (root) de la BD. La API NO la usa.
MARIADB_ROOT_PASSWORD=

# Usuario normal que usara la API (por ejemplo: petconnect_app).
# Tiene permisos solo sobre la base petconnect.
MARIADB_USER=
MARIADB_PASSWORD=
