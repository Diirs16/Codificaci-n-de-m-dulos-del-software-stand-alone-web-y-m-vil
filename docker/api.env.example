# ================================================================
# PETCONNECT — plantilla de la API en Docker (item 5.2, A-30)
#
# Copia este archivo como docker/api.env (en esta misma carpeta) y llenalo.
# docker/api.env NO se sube a Git (regla *.env del .gitignore).
# Explicacion de cada variable: petconnect.Backend/.env.example
#
# NO van aqui DB_HOST, DB_PORT, DB_NAME ni PROXY_CONFIABLE: los pone
# docker-compose.yml (db, 3306, petconnect y 1). Tampoco FLASK_DEBUG ni
# API_HOST: Gunicorn no los usa.
# ================================================================

# Los MISMOS valores de MARIADB_USER y MARIADB_PASSWORD de docker/bd.env
DB_USER=
DB_PASSWORD=

# Conexiones del pool. Vacio = 10 (alcanza para los 8 hilos de Gunicorn)
DB_POOL_SIZE=

# Vacio = no es desarrollo (lo seguro). Solo para probar sin correo real:
# desarrollo (el codigo OTP sale en "docker compose logs api").
APP_ENV=

# Dejalo vacio: en Docker la web llega a la API por nginx (mismo origen) y no
# necesita CORS. Solo se llena en Railway (item 5.5, ver petconnect.Backend/.env.example)
CORS_ORIGENES=

# sdk, smtp o gmail (ver petconnect.Backend/.env.example)
EMAIL_MODE=
MAILTRAP_API_TOKEN=
MAILTRAP_SENDER=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Obligatorias. Genera claves NUEVAS para Docker (no copies las de tu .env):
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ojo: con otra FERNET_KEY no se pueden leer datos cifrados con la anterior.
JWT_SECRET=
FERNET_KEY=
